{
  "manifest_version": 3,
  "name": "Family Tree Downloader",
  "version": "0.6.1",
  "description": "Save your own tree to GEDCOM, a feature Genotek doesn't provide. Export other people's trees as well.",
  "content_scripts": [
    {
      "matches": [
        "https://lk.genotek.ru/*",
        "https://my.genotek.eu/*"
      ],
      "js": [
        "genotek_gedcom_export.user.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "icon-128.png"
  }
}
